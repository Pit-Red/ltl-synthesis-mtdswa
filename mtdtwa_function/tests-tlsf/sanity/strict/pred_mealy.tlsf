INFO {
  TITLE:       "pred_mealy"
  DESCRIPTION: "Non-strict: G r -> G (g <-> X r). Realizable: keep g high; it is only wrong once r drops."
  SEMANTICS:   Mealy
  TARGET:      Mealy
}

MAIN {
  INPUTS { r; }
  OUTPUTS { g; }
  REQUIRE {
    r;
  }
  ASSERT {
    g <-> X r;
  }
}
//#!SYNTCOMP
//STATUS : realizable
//#.
