INFO {
  TITLE:       "pred_strictmoore"
  DESCRIPTION: "Strict: (g <-> X r) W !r. Unrealizable: the system must predict the step at which r drops."
  SEMANTICS:   Strict,Moore
  TARGET:      Moore
}

MAIN {
  INPUTS { r; }
  OUTPUTS { g; }
  REQUIRE {
    r;
  }
  ASSERT {
    g <-> X r;
  }
}
//#!SYNTCOMP
//STATUS : unrealizable
//#.
