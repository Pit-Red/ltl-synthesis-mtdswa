INFO {
  TITLE:       "resp2_mealy"
  DESCRIPTION: "Grant every request in the same step, never both grants. Unrealizable: the environment raises r1 and r2 together."
  SEMANTICS:   Mealy
  TARGET:      Mealy
}

MAIN {
  INPUTS { r1; r2; }
  OUTPUTS { g1; g2; }
  GUARANTEES {
    G ((r1 -> g1) && (r2 -> g2)) && G !(g1 && g2);
  }
}
//#!SYNTCOMP
//STATUS : unrealizable
//#.
